# `eslint-plugin-obsidianmd` declares an *exact* peer on `obsidian` (1.8.7) while
# this project follows the current published typings. Every peer that the lint
# preset needs (@eslint/js, @eslint/json, eslint, obsidian, typescript-eslint) is
# declared explicitly in devDependencies, so skipping npm's automatic peer
# installation is safe here and keeps `npm install` deterministic.
legacy-peer-deps=true

# Less noise during development.
fund=false
